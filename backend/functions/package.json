{
  "name": "fireguard-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:rules": "firebase emulators:exec --config ../../firebase.json --project demo-fireguard --only firestore,storage \"node --test test/access-rules.test.mjs\"",
    "test:operations": "firebase emulators:exec --config ../../firebase.json --project demo-fireguard --only auth,firestore,functions,storage \"node --test test/operations-flow.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.15.0",
    "firebase": "^12.7.0",
    "firebase-tools": "^14.20.0",
    "typescript": "~5.9.3"
  }
}
